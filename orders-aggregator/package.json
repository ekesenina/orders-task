{
  "name": "orders-aggregator",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
